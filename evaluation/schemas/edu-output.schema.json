{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ontotrace.local/schemas/edu-output.schema.json",
  "title": "EDU model output",
  "type": "object",
  "required": ["edus"],
  "additionalProperties": false,
  "properties": {
    "edus": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "text", "predicate", "arguments", "sources"],
        "additionalProperties": false,
        "properties": {
          "type": { "enum": ["EVENT", "STATE", "RELATION", "EVALUATION", "RULE"] },
          "text": { "type": "string", "minLength": 1 },
          "predicate": { "type": "string", "minLength": 1 },
          "arguments": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["role", "value"],
              "properties": {
                "role": {
                  "enum": ["subject", "object", "participant", "location", "origin", "destination", "instrument", "value", "other"]
                },
                "roleName": { "type": "string" },
                "value": { "type": "string", "minLength": 1 },
                "sourceForm": { "type": "string" },
                "entityType": { "type": "string" }
              }
            }
          },
          "time": {
            "type": "object",
            "properties": {
              "value": { "type": "string" },
              "sourceForm": { "type": "string" },
              "precision": { "enum": ["YEAR", "MONTH", "DAY", "UNKNOWN"] }
            }
          },
          "sources": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["contextKey", "quote"],
              "properties": {
                "contextKey": { "type": "string" },
                "quote": { "type": "string", "minLength": 1 }
              }
            }
          },
          "usedExternalKnowledge": { "type": "boolean" }
        }
      }
    }
  }
}
