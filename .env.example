SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/ontotrace
SPRING_DATASOURCE_USERNAME=ontotrace
SPRING_DATASOURCE_PASSWORD=ontotrace

BOOTSTRAP_ADMIN_USERNAME=hanbd
BOOTSTRAP_ADMIN_PASSWORD=change-me

S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=ontotrace
S3_ACCESS_KEY=silo
S3_SECRET_KEY=silo-dev
S3_PATH_STYLE_ACCESS=true

AI_PROVIDER=openai
AI_CHAT_MODEL=gpt-4o-mini
AI_REVIEW_MODEL=gpt-4o-mini
AI_API_KEY=
AI_BASE_URL=
AI_MODE=live
# EDU 模型复核步骤默认关闭，置 true 恢复复核（需 AI_MODE 为 stub 或 live）
AI_REVIEW_ENABLED=false
# Spring AI 默认 60s，EDU 抽取经常不够；需大于一次模型调用
AI_CHAT_TIMEOUT=5m

WORKER_ENABLED=true
WORKER_POLL_INTERVAL=2000
JOB_LEASE_DURATION=600
# 单进程同时执行的任务数，应明显小于数据库连接池（默认 10）
WORKER_MAX_CONCURRENCY=4
