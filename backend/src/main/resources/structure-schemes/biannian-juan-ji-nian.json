{
  "id": "biannian-juan-ji-nian",
  "name": "编年体·卷纪年",
  "toc": {
    "present": false,
    "usage": "ignore",
    "dropLeadingCopy": false
  },
  "headings": [
    {
      "id": "juan",
      "pattern": "^●?(卷(?:第)?[一二三四五六七八九十百千万零〇0-9]+[上下中]?)$",
      "level": 1,
      "label": "$1",
      "nodeType": "juan"
    },
    {
      "id": "ji",
      "pattern": "^【([^】]*纪[^】]*)】.*$",
      "level": 1,
      "label": "$1",
      "nodeType": "ji",
      "foldIntoParent": true
    },
    {
      "id": "di",
      "pattern": "^(.+?皇帝(?:[上中下]之[上中下]|[上中下]|[甲乙丙丁戊己庚辛壬癸]))",
      "level": 2,
      "label": "$1",
      "nodeType": "di",
      "prefix": true
    },
    {
      "id": "nian-ce-dot",
      "pattern": "^◎\\s*(.+?)([\\u4e00-\\u9fff]{2})[，,、]\\s*公元([〇零一二三四五六七八九0-9]+)年。?$",
      "level": 3,
      "label": "$1",
      "nodeType": "nian",
      "ganzhiGroup": 2,
      "ceYearGroup": 3
    },
    {
      "id": "nian-ce-paren",
      "pattern": "^(.+?)（([^）]+?)[，,、]\\s*公元([〇零一二三四五六七八九0-9]+)年）。?$",
      "level": 3,
      "label": "$1",
      "nodeType": "nian",
      "ganzhiGroup": 2,
      "ceYearGroup": 3
    },
    {
      "id": "nian",
      "pattern": "^([\\u4e00-\\u9fff]{0,16}?)(元年|[一二三四五六七八九十百]+年)年?$",
      "level": 3,
      "label": "$1$2",
      "nodeType": "nian"
    },
    {
      "id": "wang",
      "pattern": "^[\\u4e00-\\u9fff]{1,6}王$",
      "level": 3,
      "label": "$0",
      "nodeType": "nian",
      "mergeNextYear": true
    }
  ],
  "alignment": "title_has_volume",
  "paragraph": "blank_or_indent",
  "neighbor": {
    "noCrossJuan": true,
    "noCrossNian": true
  },
  "skipEduNodeTypes": ["toc", "table", "appendix", "front"]
}
