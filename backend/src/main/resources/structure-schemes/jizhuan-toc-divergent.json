{
  "id": "jizhuan-toc-divergent",
  "name": "纪传体·目录异形",
  "toc": {
    "present": true,
    "linePattern": "^(卷[一二三四五六七八九十百千万零〇0-9]+[上中下]?)\\s+(.+)$",
    "usage": "volume_lookup",
    "dropLeadingCopy": false
  },
  "headings": [
    {
      "id": "pian",
      "pattern": "^(本纪|本紀|世家|列[传傳伟偉]|表|书|書|志)(卷?第?[一二三四五六七八九十百千万零〇0-9]+[上中下]?)\\s*(.*)$",
      "pathTemplate": ["{tocVolume} {tocKey} $3"],
      "tocKeyTemplate": "$1$2",
      "nodeType": "pian"
    }
  ],
  "alignment": "lookup_volume_from_toc",
  "paragraph": "blank_or_indent",
  "neighbor": {
    "noCrossJuan": true,
    "noCrossNian": false
  },
  "skipEduNodeTypes": ["toc", "table", "appendix", "front"]
}
